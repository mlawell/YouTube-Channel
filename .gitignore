# Python
.venv/
__pycache__/
*.pyc

# Whisper model cache
.cache/

# AI avatar: third-party SadTalker clone + model checkpoints/weights
# (large ~1.8GB, regenerable — see tools/avatar/README.md)
tools/avatar/SadTalker/

# ATV ephemeral observation log (per project conventions)
.atv/observations.jsonl

# Playwright MCP session artifacts
.playwright-mcp/

# Channel Junkies is paid training content — keep raw transcripts/subtitles and
# course resources (PDFs/templates) local, do not redistribute. The synthesized
# playbook (derivative notes) is tracked.
knowledge/channel-junkies/transcripts/
knowledge/channel-junkies/srt/
knowledge/channel-junkies/resources/

# Reference videos: the catalog is analysis only. Captions/transcripts and any
# downloaded media for OTHER people's videos must never be committed — same rule
# as the Channel Junkies transcripts above. Research inputs stay in the session
# folder; only catalog.json and the markdown are tracked.
knowledge/reference-videos/caps/
knowledge/reference-videos/**/*.vtt
knowledge/reference-videos/**/*.srt
knowledge/reference-videos/**/*.mp4
knowledge/reference-videos/**/*.webm
knowledge/reference-videos/**/*.m4a
knowledge/reference-videos/exemplars.json
knowledge/reference-videos/scored.json

# Platform media is REFERENCED, never committed. Photos, tour video, drone
# plates and thumbnails live in the M365/OneDrive library and are addressed by
# path from each package's media-map.md — see platforms/youtube/content/README.md
# and properties/README.md. Some single source files are multi-gigabyte, so this
# fails closed rather than relying on discipline at `git add` time.
platforms/**/content/**/*.jpg
platforms/**/content/**/*.jpeg
platforms/**/content/**/*.png
platforms/**/content/**/*.gif
platforms/**/content/**/*.webp
platforms/**/content/**/*.mp4
platforms/**/content/**/*.mov
platforms/**/content/**/*.m4v
platforms/**/assets/**/*.jpg
platforms/**/assets/**/*.jpeg
platforms/**/assets/**/*.mp4
platforms/**/assets/**/*.mov
platforms/**/assets/**/*.m4v

# Phase map: regenerable. `data/` is a live pull from Bay County ArcGIS,
# `output/` is rendered from it and includes very large print masters (the
# giant raster alone is ~15 MB, the 4K frames more). Everything rebuilds with
# four commands â€” see tools/map/README.md. Downscaled previews are committed
# under tools/map/preview/ so the map is visible without running anything.
tools/map/data/
tools/map/output/
tools/map/work/
